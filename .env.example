# 复制成 .env 后按自己的服务器修改。

# 后台登录，默认 admin/admin。第一次登录后也可以在网页后台改密码。
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# /update 接口用的更新密钥。
UPDATE_TOKEN=admin

# 订阅标题。
PROFILE_TITLE=RAY-VPN-Sub

# 反代后的公网地址。用 Cloudflare/Nginx/Caddy 反代时填域名。
PUBLIC_BASE_URL=https://sub.0909106.xyz

# 可选：订阅密钥。填了以后后台显示的订阅链接会自动带 ?token=xxx。
SUB_TOKEN=

# 宿主机对外端口。反代时 Nginx/Caddy 指向 http://127.0.0.1:18002。
HOST_PORT=18002

# 数据目录。保留这个目录，节点和备份就不会丢。
DATA_PATH=/opt/1panel/www/sites/sub.0909106.xyz/index/data

TZ=Asia/Shanghai

# Upstream subscription fetch User-Agent.
# Examples: ClashMetaForAndroid/2.11.13 or clash-verge/v2.0.0
UPSTREAM_USER_AGENT=ClashMetaForAndroid/2.11.13

# subs-check 优选检测。后台节点页会读取/保存这个配置文件。
SUBS_CHECK_SUBSCRIPTION_ENABLED=1
SUBSCRIPTION_ENGINE_MODE=balanced
SUBS_CHECK_MIN_OUTPUT_NODES=20
SUBS_CHECK_BASE_URL=http://subs-check:8199
SUBS_CHECK_PUBLIC_URL=http://127.0.0.1:18199
SUBS_CHECK_CONFIG_FILE=/subs-check/config/config.yaml
SUBS_CHECK_OUTPUT_DIR=/subs-check/output
SUBS_CHECK_API_KEY=iguang-subs-check
